[project]
name = "McCache"
dynamic = ["version"]
authors = [
  { name="Edward Lau", email="elau1004@netscape.net" },
# { name="Daniel Escobar", email="daniel.escobar1037@gmail.com" },
]
maintainers = [
  { name="Edward Lau", email="elau1004@netscape.net" },
]
description = "McCache is a, write through cluster aware, local in-memory caching library."
readme = "README.md"
requires-python = ">=3.14"
license = "MIT"
keywords = [
  "cache",
  "cluster",
  "distributed",
  "eventual",
  "local",
  "mccache",
  "multicast",
  "optimistic",
  "performance",
  "scale-out",
  "scale-up",
  "udp",
]
classifiers = [  #! Update me
  "Development Status :: 5 - Production/Stable",
  "Intended Audience :: Developers",
  "Operating System :: OS Independent",
  "Topic :: Software Development :: Libraries :: Python Modules",
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: 3.12",
  "Programming Language :: Python :: 3.13",
  "Programming Language :: Python :: 3.14",
  "Programming Language :: Python :: Implementation :: CPython",
]
dependencies = [
    "psutil>=7.1.0",
    "cryptography>=46.0.2",
]
[dependency-groups]
test = [
    "faker>=37.11.0",         # Test data faker.
]
dev = [ # As of 2025-10-13.
    "pre-commit>=4.3.0",      # Git pre-commit hook.
    "podman-compose>=1.5.0",  # Use podman to launch 'docker-compose.yml' file.
    "bandit>=1.8.6",          # Security issues scanner.
#   "pyupgrade">=3.10.1",     # Upgrade to modern Python syntax.
#   "darglint>=1.8.1",        # Docstring linter expect docstring formatted suing Google Python Style Guide.
    "mypy>=1.18.2",           # Static type checker for Python.
    "ruff>=0.14.0",           # Extremely fast Python linter.  Use this as the default.
    "vulture>=2.14",          # Dead code scanner.
    "faker>=37.11.0",         # Test data faker.
    "pytest>=8.4.2",          # Unit testing framework.
    "pytest-bdd>=8.1.0",      # Subset of Gherkin language for Behavioral Driven Development.
    "pytest-docker>=3.2.3",   # Docker based image testing.
    "py-spy>=0.4.1",          # Sampling profiler for Python programs.
    "coverage>=7.10.7",       # Measure code coverage.
    "hatch>=1.14.2",          # The build tool with dynamic versioning.
    "twine>=6.2.0",           # Package uploader for PyPI/TestPyPi.
]
[project.urls]
Homepage = "https://github.com/McCache/McCache-for-Python"
Source = "https://github.com/McCache/McCache-for-Python"
Issues = "https://github.com/McCache/McCache-for-Python/issues"

# SEE: https://pypa-build.readthedocs.io/en/stable/index.html
# SEE: https://hatch.pypa.io/latest/config/build/


[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.version]
path = "src/mccache/__about__.py"

[tool.hatch.envs.types]
extra-dependencies = [
  "mypy>=1.18.2",
]

[tool.hatch.envs.types.scripts]
check = "mypy --install-types --non-interactive {args:src/mccache tests}"

[tool.hatch.build]
include = [
  "LICENSE",
  "README.md",
  "RELEASES.md",
  "SECURITY.md",
  "*.py",
]
exclude = [
  ".*",
  "CODE_OF_CONDUCT.md",
  "CONTRIBUTING.md",
  "tests/",
  "pyproject.toml"
]

[tool.hatch.build.sources]
"src/mccache" = "mccache"
"src/pycache" = "pycache"

[tool.hatch.build.targets.sdist]
ignore-vcs = true
include = [
  "docs/",
  "src/",
  "tests/",
  "pyproject.toml.sample",
]
exclude = [
  "pyproject.toml"
]

# SEE: https://hatch.pypa.io/latest/how-to/publish/repo/
# Set  HATCH_INDEX_REPO envar.
# Set  HATCH_INDEX_USER envar.
# Set  HATCH_INDEX_AUTH envar.
#
[tool.hatch.publish]
default = "testpypi"  # Default repository if none is specified.
environments = ["pypi", "testpypi"]

[tool.hatch.publish.repositories]
pypi    = { url="https://upload.pypi.org/legacy/" ,username="__token__" ,password={env = "PYPI_MAIN_API_TOKEN"} }
testpypi= { url="https://test.pypi.org/legacy/"   ,username="__token__" ,password={env = "PYPI_TEST_API_TOKEN"} }

[[tool.hatch.envs.all.matrix]]
python = [
  "3.12",
  "3.13",
  "3.14"
]

[tool.hatch.envs.lint]
detached = true
dependencies = [
# "black>=23.1.0",
# "blue>=0.9.1",
  "mypy>=1.18.2",
  "ruff>=0.0.287",
]

[tool.hatch.envs.lint.scripts]
typing = "mypy --install-types --non-interactive {args:src/mccache tests}"
style = [
# "black --check --diff {args:src/mccache}",
  "ruff {args:src/mccache}",
]
fmt = [
# "black {args:src/mccache}",
  "ruff --fix {args:src/mccache tests}",
  "style",
]
all = [
  "style",
  "typing",
]

[tool.hatch.envs.test]
dependencies = [
  "coverage[toml]",
  "pytest"
]

[tool.hatch.envs.test.scripts]

[tool.coverage.run]
source_pkgs = ["mccache", "pycache", "tests"]
branch = true
parallel = true
omit = [
  "src/mccache/__about__.py",
  "src/pycache/__about__.py",
]

[tool.coverage.paths]
mccache = ["src/mccache", "src/pycache"]
tests = ["tests/unit", "tests/stress"]

[tool.coverage.report]
exclude_lines = [
  "no cov",
  "if __name__ == .__main__.:",
  "if TYPE_CHECKING:",
]


[tool.bandit]
skips = ["B101" ,"B301" ,"B311" ,"B324" ,"B403"]

[tool.black]
target-version = ["py314"]
line-length = 160   # But you should exercise good judgement and keep it as short as possible.
skip-string-normalization = true

[tool.pytest.ini_options]
pythonpath = "src"
testpaths = [
    "tests/unit",
    "tests/e2e",
]

[tool.ruff]
target-version = "py314"
line-length = 160
select = [
  "A",    # flake8-builtins
  "ARG",  # flake8-unused-arguments
  "B",    # flake8-bugbear
  "BLE",
  "C",    #
  "C4",
  "C90",
  "DTZ",  # flake8-datetimez
  "E",    #
  "EM",   # flake8-errmsg
  "F",    # Pyflakes
  "FBT",  # flake8-boolean-trap
  "I",    # isort
  "ICN",  # flake8-import-conventions
  "ISC",  # flake8-implicit-str-concat
  "N",    # pep8-naming
  "PLC",  #
  "PLE",  #
  "PLR",  #
  "PLW",  #
  "Q",    # flake8-quotes
  "RET",
  "RSE",
  "RUF",  # Ruff-specific rules
  "S",    # flake8-bandit
  "T",    #
  "TCH",
  "TID",  # flake8-tidy-imports
  "UP",   # pyupgrade
  "W",    #
  "YTT",  # flake8-2020
]
ignore = [
  # Allow non-abstract empty methods in abstract base classes
  "B027",

  # Boolean default positional argument in function definition
  "FBT002",

  # Allow boolean positional values in function calls, like `dict.get(... True)`
  #"FBT003",

  # Allow mixed-case-variable-in-global-scope
  "N816",

  # Ignore checks for possible passwords
  #"S105", "S106", "S107",

  # Ignore bad-quotes-inline-string
  "Q000",

  # Ignore complexity
  #"C901", "PLR0911", "PLR0912", "PLR0913", "PLR0915",

  # raw-string-in-exception
  "EM101",

  # Variable should be lowercase
  "N806",

  # explicit-f-string-type-conversion
  "RUF010",

  # superfluous-else-return
  "RET505",
]
unfixable = [
  # Don't touch unused imports
  "F401",
]

[tool.ruff.mccabe]
max-complexity = 16

[tool.ruff.pylint]
max-args = 10
max-branches = 16

[tool.ruff.isort]
known-first-party = ["mccache"]

[tool.ruff.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.per-file-ignores]
# Tests can use magic values, assertions, and relative imports
"src/**/*"   = ["ARG001", "PLR0913", "PLR1730", "RUF019" ]
"tests/**/*" = ["PLR2004", "S101", "TID252"]
